@model App_projekt_IT.Models.AppointmentSlot

@{
    ViewData["Title"] = "Szczegóły wizyty";
}

<div class="crud-form-container details-container">
    <h2>Szczegóły Twojej wizyty</h2>

    <div class="detail-block">
        <h3><i class="fa-solid fa-calendar-check"></i> Informacje o wizycie</h3>
        <p><strong>Data:</strong> @Model.StartTime.ToString("dd.MM.yyyy")</p>
        <p><strong>Godzina:</strong> @Model.StartTime.ToString("HH:mm")</p>
        <p><strong>Zarezerwowana usługa:</strong> @Model.Service?.Name</p>
    </div>

    <div class="detail-block">
        <h3><i class="fa-solid fa-user-doctor"></i> Lekarz specjalista</h3>
        <p class="doctor-name">
            <strong>@Model.Doctor?.Title @Model.Doctor?.FirstName @Model.Doctor?.LastName</strong>
        </p>
    </div>

    <div class="detail-block">
        <h3><i class="fa-solid fa-hospital"></i> Miejsce wizyty</h3>
        <p><strong>Klinika:</strong> @Model.Doctor?.Clinic?.Name</p>
        <p class="text-muted">
            <i class="fa-solid fa-location-dot"></i> @Model.Doctor?.Clinic?.Address, @Model.Doctor?.Clinic?.PostalCode
            @Model.Doctor?.Clinic?.City?.Name
        </p>

        <hr class="detail-divider" />

        <p><i class="fa-solid fa-phone"></i> <strong>Telefon:</strong> @Model.Doctor?.Clinic?.Phone</p>
        <p><i class="fa-solid fa-envelope"></i> <strong>Email:</strong> @Model.Doctor?.Clinic?.Email</p>
    </div>

    <div class="action-buttons center-buttons">
        <a asp-action="Index" class="btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Powrót do listy wizyt
        </a>
    </div>
</div>
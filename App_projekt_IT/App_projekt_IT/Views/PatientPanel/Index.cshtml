@model IEnumerable<App_projekt_IT.Models.AppointmentSlot>

@{
    ViewData["Title"] = "Moje Wizyty";
}

<div class="admin-header">
    <h1>Moje zarezerwowane wizyty</h1>
</div>

<div>
    <table class="custom-table">
        <thead>
            <tr>
                <th>Data i godzina</th>
                <th>Lekarz</th>
                <th>Usługa</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4">
                        Nie masz obecnie żadnych zaplanowanych wizyt.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr class="custom-table">
                        <td>
                            @item.StartTime.ToString("dd.MM.yyyy HH:mm")
                        </td>

                        <td>
                            @item.Doctor.Title @item.Doctor.FirstName @item.Doctor.LastName
                        </td>

                        <td>
                            @item.Service.Name
                        </td>

                        <td style="display: flex; align-items: center; gap: 3rem;">

                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-primary">
                                <i class="fa-solid fa-circle-info"></i> Szczegóły
                            </a>

                            @if (item.StartTime > DateTime.Now)
                            {
                                <form asp-action="CancelReservation" method="post" style="margin: 0;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-secondary"
                                            onclick="return confirm('Czy na pewno chcesz odwołać tę wizytę?');">
                                        <i class="fa-solid fa-xmark"></i> Odwołaj
                                    </button>
                                </form>
                            }
                            else if (item.IsConfirmed && !item.IsReviewed)
                            {
                                <a asp-controller="Review" asp-action="Create" asp-route-appointmentId="@item.Id" class="btn-rate">
                                    <i class="fa-solid fa-star"></i> Oceń wizytę
                                </a>
                            }
                            else if (item.IsReviewed)
                            {
                                <span class="text-muted" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                                    <i class="fa-solid fa-check-double"></i> Oceniono
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
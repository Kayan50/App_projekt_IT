@model IEnumerable<App_projekt_IT.Models.AppointmentSlot>

@{
    ViewData["Title"] = "Moje Wizyty";
}

<div class="admin-header">
    <h1>Moje zarezerwowane wizyty</h1>
</div>

<div>
    <table class="custom-table">
        <thead>
            <tr>
                <th>Data i godzina</th>
                <th>Lekarz</th>
                <th>Usługa</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4">
                        Nie masz obecnie żadnych zaplanowanych wizyt.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr class="custom-table">
                        <td>
                            @item.StartTime.ToString("dd.MM.yyyy HH:mm")
                        </td>

                        <td>
                            @item.Doctor.Title @item.Doctor.FirstName @item.Doctor.LastName
                        </td>

                        <td>
                            @item.Service.Name
                        </td>

                        <td style="display: flex; align-items: center; gap: 3rem;">

                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-primary">
                                <i class="fa-solid fa-circle-info"></i> Szczegóły
                            </a>

                            @if (item.StartTime > DateTime.Now)
                            {
                                <form id="cancel-form-@item.Id" asp-action="CancelReservation" method="post" style="margin: 0;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="button" class="btn-secondary"
                                            onclick="openCancelModal(@item.Id, '@item.Doctor.LastName', '@item.StartTime.ToString("dd.MM.yyyy HH:mm")')">
                                        <i class="fa-solid fa-xmark"></i> Odwołaj
                                    </button>
                                </form>
                            }
                            else if (item.IsConfirmed && !item.IsReviewed)
                            {
                                <a asp-controller="Review" asp-action="Create" asp-route-appointmentId="@item.Id" class="btn-rate">
                                    <i class="fa-solid fa-star"></i> Oceń wizytę
                                </a>
                            }
                            else if (item.IsReviewed)
                            {
                                <span class="text-muted" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                                    <i class="fa-solid fa-check-double"></i> Oceniono
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div id="cancelModal" class="modal-overlay hidden">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Odwołanie wizyty</h3>
        </div>

        <div class="modal-body">
            <p>Czy na pewno chcesz odwołać wizytę u lekarza<br><strong id="cancelDoctorName"></strong>?</p>
            <p>Termin: <strong id="cancelDate"></strong></p>
            <p class="text-danger" style="margin-top: 1rem; font-size: 0.9rem;">
                Ta operacja jest nieodwracalna.
            </p>
        </div>

        <div class="action-buttons" style="margin-top: 0;">
            <button type="button" onclick="confirmCancel()" class="btn-primary" style="background-color: #ef4444; border-color: #ef4444;">
                <i class="fa-solid fa-trash"></i> Tak
            </button>
            <button type="button" onclick="closeCancelModal()" class="btn-secondary">
                <i class="fa-solid fa-times"></i> Wróć
            </button>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let currentCancelFormId = null;

        
        function openCancelModal(appointmentId, doctorName, date) {
            currentCancelFormId = 'cancel-form-' + appointmentId;
            document.getElementById('cancelDoctorName').innerText = "dr " + doctorName;
            document.getElementById('cancelDate').innerText = date;

            document.getElementById('cancelModal').classList.remove('hidden');
        }

        
        function closeCancelModal() {
            document.getElementById('cancelModal').classList.add('hidden');
            currentCancelFormId = null;
        }

        
        function confirmCancel() {
            if (currentCancelFormId) {
                
                document.getElementById(currentCancelFormId).submit();
            }
        }
    </script>
}
@model App_projekt_IT.Models.City

@{
    ViewData["Title"] = "Edytuj Miasto";
}

<div class="admin-header">
    <h1>Edytuj dane miasta</h1>
</div>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />
    <div class="clinic-card">

        <div class="form-group">
            <label asp-for="Name">Nazwa</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Voivodeship">Województwo</label>
            <input asp-for="Voivodeship" class="form-control" />
            <span asp-validation-for="Voivodeship" class="text-danger"></span>
        </div>
    </div>

    <div class="action-buttons">
        <button type="submit" class="btn-primary">Zapisz zmiany</button>
        <a asp-action="Index" class="btn-secondary">Powrót do listy</a>
    </div>
</form>




@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
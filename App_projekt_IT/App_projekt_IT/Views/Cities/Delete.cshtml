@model App_projekt_IT.Models.City

@{
    ViewData["Title"] = "Usuń Miasto";
}

<h2>Usuń Miasto</h2>

<dl class="row">
    <dt>Nazwa</dt>
    <dd>@Html.DisplayFor(model => model.Name)</dd>

    <dt>Województwo</dt>
    <dd>@Html.DisplayFor(model => model.Voivodeship)</dd>

</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="action-buttons">
        <button type="submit" class="btn-primary">Usuń bezpowrotnie</button>
        <a asp-action="Index" class="btn-secondary">Powrót do listy</a>
    </div>
</form>
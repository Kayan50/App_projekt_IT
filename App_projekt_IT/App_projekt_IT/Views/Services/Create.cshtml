@model App_projekt_IT.Models.Service

@{
    ViewData["Title"] = "Dodaj Usługę";
}

<div class="admin-header">
    <h1>Dodaj nową usługę</h1>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="clinic-card">

        <div class="form-group">
            <label asp-for="Name">Nazwa</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="checkbox-group">
            <label asp-for="IsNFZ">Dostępna przez NFZ</label>
            <input asp-for="IsNFZ" type="checkbox" />
            <span asp-validation-for="IsNFZ" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">Opis usługi</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Zdjęcie usługi (opcjonalnie)</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>

        <div class="checkbox-group">
            <label asp-for="IsHighlighted">Wyróżnij na stronie głównej</label>
            <input asp-for="IsHighlighted" type="checkbox" />
            <span asp-validation-for="IsHighlighted" class="text-danger"></span>
        </div>
    </div>
    
    <div class="action-buttons">
        <button type="submit" class="btn-primary">Utwórz usługę</button>
        <a asp-action="Index" class="btn-secondary">Powrót do listy</a>
    </div>


</form>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
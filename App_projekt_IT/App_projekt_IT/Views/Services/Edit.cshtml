@model App_projekt_IT.Models.Service

@{
    ViewData["Title"] = "Edytuj Usługu";
}

<h2>Edytuj dane usługi</h2>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />
    <div class="clinic-card">

        <div class="form-group">
            <label asp-for="Name">Usługa</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="checkbox-group">
            <label asp-for="IsNFZ">Czy usługa jest objęta NFZ?</label>
            <input asp-for="IsNFZ" type="checkbox" />
            <span asp-validation-for="IsNFZ" class="text-danger"></span>
        </div>
    </div>

    <div class="action-buttons">
        <button type="submit" class="btn-primary">Zapisz zmiany</button>
        <a asp-action="Index" class="btn-secondary">Powrót do listy</a>
    </div>
</form>




@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@model App_projekt_IT.Models.Service

@{
    ViewData["Title"] = "Edytuj Usługu";
}

<h2>Edytuj dane usługi</h2>

<div class="clinic-card">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="checkbox-group">
            <label asp-for="IsNFZ">Czy usługa jest objęta NFZ?</label>
            <input asp-for="IsNFZ" type="checkbox" />
            <span asp-validation-for="IsNFZ" class="text-danger"></span>
        </div>

        <div class="action-links">
            <button type="submit" class="btn-primary">Zapisz zmiany</button>
        </div>
    </form>
</div>

<div class="action-links" style="margin-top: 15px;">
    <a asp-action="Index">Powrót do listy</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@model App_projekt_IT.Models.Service

@{
    ViewData["Title"] = "Usuń Usługę";
}

<h2>Usuń Usługę</h2>

<h4 class="warning-text">Czy na pewno chcesz usunąć tę usługę? Operacja jest nieodwracalna.</h4>

<dl class="row">
    <dt>Nazwa</dt>
    <dd>@Html.DisplayFor(model => model.Name)</dd>

    <dt>Czy usługa jest objęta przez NFZ</dt>
    <dd>
        @if (Model.IsNFZ)
        {
            <span style="color: #10b981; font-weight: 500;">Tak</span>
        }
        else
        {
            <span style="color: #ef4444; font-weight: 500;">Nie</span>
        }
    </dd>
</dl>


<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="action-buttons">
        <button type="submit" class="btn-primary">Usuń bezpowrotnie</button>
        <a asp-action="Index" class="btn-secondary">Powrót do listy</a>
    </div>
</form>
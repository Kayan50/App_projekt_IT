@model App_projekt_IT.Models.Service

@{
    ViewData["Title"] = "Usuń Usługę";
}

<h2>Usuń Usługę</h2>
<h4 class="warning-text">Czy na pewno chcesz usunąć tę usługę? Operacja jest nieodwracalna.</h4>

<div class="clinic-card">
    <dl>
        <dt>@Html.DisplayNameFor(model => model.Name)</dt>
        <dd>@Html.DisplayFor(model => model.Name)</dd>

        <dt>@Html.DisplayNameFor(model => model.IsNFZ)</dt>
        <dd>@Html.DisplayFor(model => model.IsNFZ)</dd>
    </dl>
</div>

<div class="action-links">
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn-primary">Usuń bezpowrotnie</button>
        <a asp-action="Index">Powrót do listy</a>
    </form>
</div>
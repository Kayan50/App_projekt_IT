@model IEnumerable<App_projekt_IT.Models.Service>

<div class="admin-container">
    <div class="admin-header">
        <h1>Zarządzaj Usługami</h1>
        <div style="display: flex; gap: 1rem;">
            <a asp-action="Create" class="btn-create-new">Dodaj nową usługę</a>
        </div>
    </div>

    <table class="custom-table">
        <thead>
            <tr>
                <th>Nazwa Usługi</th>
                <th>Refundacja NFZ</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>
                        @if (item.IsNFZ)
                        {
                            <span style="color: #10b981; font-weight: 500;">Tak</span>
                        }
                        else
                        {
                            <span style="color: #ef4444; font-weight: 500;">Nie</span>
                        }
                    </td>
                    <td class="action-links">
                        <a asp-action="Edit" asp-route-id="@item.Id">Edytuj</a>
                        <a asp-action="Details" asp-route-id="@item.Id">Szczegóły</a>
                        <a asp-action="Delete" asp-route-id="@item.Id">Usuń</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
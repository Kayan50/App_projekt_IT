@model App_projekt_IT.Models.Doctor

@{
    ViewData["Title"] = "Edytuj Lekarza";
}

<div class="admin-header">
    <h1>Edytuj dane lekarza</h1>
</div>

<form asp-action="Edit" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />

    <input type="hidden" asp-for="ImageData" />
    <input type="hidden" asp-for="ImageContentType" />

    <div class="clinic-card">

        <div class="form-group">
            <label asp-for="FirstName">Imię</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LastName">Nazwisko</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Title">Tytuł</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ClinicId">Klinika</label>
            <select asp-for="ClinicId" class="form-control" asp-items="ViewBag.ClinicId"></select>
            <span asp-validation-for="ClinicId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Zmień zdjęcie (pozostaw puste, aby zachować obecne)</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />

            @if (Model.ImageData != null && Model.ImageContentType != null)
            {
                string imageBase64 = Convert.ToBase64String(Model.ImageData);
                string imageSrc = $"data:{Model.ImageContentType};base64,{imageBase64}";

                <div style="margin-top: 1rem;">
                    <p class="text-muted" style="margin-bottom: 0.5rem;">
                        <small>Obecnie wgrane zdjęcie:</small>
                    </p>
                    <img src="@imageSrc" alt="Zdjęcie lekarza" style="max-width: 150px; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);" />
                </div>
            }
        </div>
    </div>

    <div class="action-buttons">
        <button type="submit" class="btn-primary">Zapisz zmiany</button>
        <a asp-action="Index" class="btn-secondary">Powrót do listy</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
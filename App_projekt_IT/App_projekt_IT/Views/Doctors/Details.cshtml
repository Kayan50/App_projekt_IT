@model App_projekt_IT.Models.Doctor

@{
    ViewData["Title"] = "Szczegóły Lekarza";
}

<div class="admin-header">
    <h1>Szczegóły Lekarza</h1>
</div>

<dl class="row">
    <dt>Imie</dt>
    <dd>@Html.DisplayFor(model => model.FirstName)</dd>

        <dt>Nazwisko</dt>
        <dd>@Html.DisplayFor(model => model.LastName)</dd>

        <dt>Tytuł</dt>
        <dd>@Html.DisplayFor(model => model.Title)</dd>

        <dt>Klinika</dt>
        <dd>@Html.DisplayFor(model => model.Clinic.Name)</dd>
    </dl>

<div class="action-buttons">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-primary">Edytuj</a>
    <a asp-action="Index" class="btn-secondary">Powrót do listy</a>
</div>
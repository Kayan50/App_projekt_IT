@model App_projekt_IT.Models.Doctor

@{
    ViewData["Title"] = "Usuń Lekarza";
}

<h2>Usuń Lekarza</h2>
<h4 class="warning-text">Czy na pewno chcesz usunąć tego lekarza? Operacja jest nieodwracalna.</h4>

<dl class="row">
    <dt>Imie</dt>
    <dd>@Html.DisplayFor(model => model.FirstName)</dd>

    <dt>Nazwisko</dt>
    <dd>@Html.DisplayFor(model => model.LastName)</dd>

    <dt>Tytuł</dt>
    <dd>@Html.DisplayFor(model => model.Title)</dd>

    <dt>Klinika</dt>
    <dd>@Html.DisplayFor(model => model.Clinic.Name)</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="action-buttons">
        <button type="submit" class="btn-primary">Usuń bezpowrotnie</button>
        <a asp-action="Index" class="btn-secondary">Powrót do listy</a>
    </div>
</form>

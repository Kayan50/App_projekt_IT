@model App_projekt_IT.Models.Doctor

@{
    ViewData["Title"] = "Dodaj Lekarza";
}

<h2>Dodaj nowego lekarza</h2>

<div class="clinic-card">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LastName"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ClinicId"></label>
            <select asp-for="ClinicId" class="form-control" asp-items="ViewBag.ClinicId"></select>
            <span asp-validation-for="ClinicId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <button type="submit" class="btn-primary">Utwórz lekarza</button>
        </div>
    </form>
</div>

<div class="action-links">
    <a asp-action="Index">Powrót do listy</a>
</div>
@model App_projekt_IT.Models.Doctor

@{
    ViewData["Title"] = "Dodaj Lekarza";
}

<div class="admin-header">
    <h1>Dodaj nowego lekarza</h1>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="clinic-card">

        <div class="form-group">
            <label asp-for="FirstName">Imię</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LastName">Nazwisko</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Title">Tytuł</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ClinicId">Klinika</label>
            <select asp-for="ClinicId" class="form-control" asp-items="ViewBag.ClinicId"></select>
            <span asp-validation-for="ClinicId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Zdjęcie lekarza (opcjonalnie)</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>

    </div>

    <div class="action-buttons">
        <button type="submit" class="btn-primary">Utwórz lekarza</button>
        <a asp-action="Index" class="btn-secondary">Powrót do listy</a>
    </div>
</form>
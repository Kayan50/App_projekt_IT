<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Kliniki-Med</title>

    <link rel="stylesheet" href="~/css/styles.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
    <header class="main-header">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="logo">Kliniki-Med</a>

        <nav class="custom-nav-container">
            @if (User.IsInRole("Admin"))
            {
                <div class="admin-links">
                    <a asp-area="" asp-controller="Clinics" asp-action="Index">Zarządzaj Klinikami</a>
                    <a asp-area="" asp-controller="Doctors" asp-action="Index">Zarządzaj Lekarzami</a>
                    <a asp-area="" asp-controller="Services" asp-action="Index">Zarządzaj Usługami</a>
                    <a asp-area="" asp-controller="Cities" asp-action="Index">Zarządzaj Miastami</a>
                </div>
            }

            <partial name="_LoginPartial" />
        </nav>
    </header>
    <div class="container">
        <main>
            @RenderBody()
        </main>
    </div>

        <script src="~/js/app.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>
<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Kliniki-Med</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>

<body>
    <header class="main-header">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="logo">Kliniki-Med</a>

        <button class="hamburger-btn" id="mobile-menu-btn" aria-label="Otwórz menu">
            <i class="fa-solid fa-bars"></i>
        </button>

        <nav class="custom-nav-container">
            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
                var currentPage = ViewContext.RouteData.Values["page"]?.ToString();

                string[] adminControllers = { "Clinics", "Doctors", "Services", "Cities", "AdminSchedules" };

                bool isManaging = adminControllers.Contains(currentController) || (currentArea == "Identity" && currentPage
                            != null && currentPage.Contains("/Manage/"));
            }

            @if (User.IsInRole("Admin") && isManaging)
            {
                <div class="admin-links">
                    <a asp-area="" asp-controller="Clinics" asp-action="Index"
                       class="@(currentController == "Clinics" ? "active" : "")">Zarządzaj Klinikami</a>
                    <a asp-area="" asp-controller="Doctors" asp-action="Index"
                       class="@(currentController == "Doctors" ? "active" : "")">Zarządzaj Lekarzami</a>
                    <a asp-area="" asp-controller="AdminSchedules" asp-action="Index"
                       class="@(currentController == "AdminSchedules" ? "active" : "")">Zarządzaj Terminami</a>
                    <a asp-area="" asp-controller="Services" asp-action="Index"
                       class="@(currentController == "Services" ? "active" : "")">Zarządzaj Usługami</a>
                    <a asp-area="" asp-controller="Cities" asp-action="Index"
                       class="@(currentController == "Cities" ? "active" : "")">Zarządzaj Miastami</a>
                </div>
            }

            <partial name="_LoginPartial" />
        </nav>
    </header>

    @{
        bool isHomePage = ViewData["Title"]?.ToString() == "Strona Główna" || ViewData["Title"]?.ToString() ==
   "Wyszukiwarka";
        string spacingClass = isHomePage ? "" : "page-spacing";
    }

    <main class="container main-content @spacingClass">
        @RenderBody()
    </main>

    <footer class="main-footer">
        <div class="footer-container">
            <div class="footer-links">
                <a asp-area="" asp-controller="Home" asp-action="Index">Strona główna</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Polityka Prywatności</a>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; 2026 Tomasz Król, Adam Łukasik. Wszelkie prawa zastrzeżone.</p>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
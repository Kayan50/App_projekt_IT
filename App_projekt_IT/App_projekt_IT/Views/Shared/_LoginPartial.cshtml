@using Microsoft.AspNetCore.Identity
@using App_projekt_IT.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="auth-links">
    @if (SignInManager.IsSignedIn(User))
    {
        <a asp-controller="PatientPanel" asp-action="Index" class="nav-panel" title="Moje Wizyty"><i
            class="fa-regular fa-calendar"></i> Panel</a>

            <a asp-area="Identity" asp-page="/Account/Manage/Index" title="Ustawienia profilu"><i
                class="fa-solid fa-gear"></i></a>

                <form asp-area="Identity" asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" style="display:inline;">
                    <button type="submit" class="nav-item-text">Wyloguj<i class="fa-solid fa-arrow-right-from-bracket"></i></button>
                </form>
            }
    else
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="nav-login">
                    Zaloguj
                </a>

                <a asp-area="Identity" asp-page="/Account/Register" class="nav-register">
                    Rejestracja <i class="fa-regular fa-circle-user"></i>
                </a>
            }
        </div>
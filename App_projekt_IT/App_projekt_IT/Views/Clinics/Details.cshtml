@model App_projekt_IT.Models.Clinic

@{
    ViewData["Title"] = "Szczegóły Kliniki";
}

<div class="admin-header">
    <h1>Szczegóły Kliniki</h1>
</div>


<dl class="row">
    <dt>Nazwa</dt>
    <dd>@Html.DisplayFor(model => model.Name)</dd>

    <dt>Telefon</dt>
    <dd>@Html.DisplayFor(model => model.Phone)</dd>

    <dt>Email</dt>
    <dd>@Html.DisplayFor(model => model.Email)</dd>

    <dt>Adres</dt>
    <dd>@Html.DisplayFor(model => model.Address)</dd>

    <dt>Kod pocztowy</dt>
    <dd>@Html.DisplayFor(model => model.PostalCode)</dd>

    <dt>Miasto</dt>
    <dd>@Html.DisplayFor(model => model.City.Name)</dd>
</dl>

<div class="action-buttons">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-primary">Edytuj</a>
    <a asp-action="Index" class="btn-secondary">Powrót do listy</a>
</div>

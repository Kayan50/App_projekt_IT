@using App_projekt_IT.Models
@{
    ViewData["Title"] = "Strona Główna";
    // Sprawdzamy czy to admin
    bool isAdmin = User.IsInRole("Admin") || User.Identity?.Name == "admin@kliniki.pl";
}

@if (isAdmin)
{
    <partial name="AdminPanel" />
}
else
{
    <div class="landing-page"
         style="text-align: center; padding: 6rem 2rem; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; justify-content: center; min-height: 60vh;">

        <h1 style="color: var(--brand-bg); font-size: 3.5rem; font-weight: 800; letter-spacing: -1px; margin-bottom: 1rem;">
            Witaj w Kliniki-Med
        </h1>
        <p style="font-size: 1.25rem; color: #475569; margin-bottom: 4rem;">
            Twój nowoczesny system rezerwacji wizyt medycznych online.
        </p>

        <div>
            <a asp-controller="Home" asp-action="Search" class="btn-primary"
               style="padding: 1.2rem 3rem; font-size: 1.2rem; border-radius: 50px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.8rem; box-shadow: 0 10px 15px -3px rgba(244, 63, 94, 0.3);">
                Znajdź wolny termin <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>
    </div>

    @if (ViewBag.TopReviews != null)
    {
        var reviews = (List<Review>)ViewBag.TopReviews;

        if (reviews.Any())
        {
            <section class="reviews-section">
                <div >
                    <h2>Co mówią o nas pacjenci?</h2>
                </div>

                <div class="grid-container">
                    @foreach (var review in reviews)
                    {
                        <div class="clinic-card">
                            <div class="rating-stars">
                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <span>⭐</span>
                                }
                            </div>

                            <p class="review-comment" >
                                "@review.Comment"
                            </p>

                            <p class="text-muted">
                                <small>
                                    Wizyta u: <strong>dr @review.AppointmentSlot.Doctor.LastName</strong><br />
                                    Data: @review.CreatedAt.ToString("dd.MM.yyyy")
                                </small>
                            </p>
                        </div>
                    }
                </div>
            </section>
        }
    }
}
@using App_projekt_IT.Models
@{
    ViewData["Title"] = "Strona Główna";
    bool isAdmin = User.IsInRole("Admin") || User.Identity?.Name == "admin@kliniki.pl";
}

@if (isAdmin)
{
    <partial name="AdminPanel" />
}
else
{
    <div class="hero-section">
        <div class="hero-content">
            <h1>
                Witaj w Kliniki-Med
            </h1>
            <p>
                Twój nowoczesny system rezerwacji wizyt medycznych online.
            </p>

            <div class="hero-form">
                <a asp-controller="Home" asp-action="Search" class="btn-primary hero-btn">
                    Znajdź wolny termin <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    @if (ViewBag.HighlightedServices != null)
    {
        var services = ViewBag.HighlightedServices as IEnumerable<Service>;

        if (services != null && services.Any())
        {
            <section class="services-section" style="margin-top: 4rem;">
                <div class="reviews-header text-center" style="margin-bottom: 3rem; text-align: center;">
                    <h2 style="color: var(--brand-bg); font-size: 2.2rem; font-weight: 700; letter-spacing: -0.5px;">
                        Poznaj nasze specjalizacje
                    </h2>
                    <p class="text-muted">Kompleksowa opieka medyczna na najwyższym poziomie</p>
                </div>

                <div class="services-grid">
                    @foreach (var service in services)
                    {
                        <div class="service-card-horizontal">

                            @if (service.ImageData != null && service.ImageContentType != null)
                            {
                                string imageBase64 = Convert.ToBase64String(service.ImageData);
                                string imageSrc = $"data:{service.ImageContentType};base64,{imageBase64}";

                                <div class="service-image-container">
                                    <img src="@imageSrc" alt="@service.Name" class="service-image" />
                                </div>
                            }
                            else
                            {
                                <div class="service-image-container fallback-icon">
                                    <i class="fa-solid fa-stethoscope"></i>
                                </div>
                            }
                            <div class="service-content">
                                <h3 class="service-title">@service.Name</h3>

                                <p class="service-desc text-muted">
                                    @service.Description
                                </p>

                                <div class="action-buttons" style="margin-top: auto; justify-content: flex-start;">
                                    <a asp-controller="Home" asp-action="Search" asp-route-serviceId="@service.Id"
                                       class="btn-secondary">
                                        <i class="fa-regular fa-calendar-check" style="margin-right: 0.4rem;"></i> Sprawdź terminy
                                    </a>
                                </div>
                            </div>

                        </div>
                    }
                </div>
            </section>
        }
    }
    @if (ViewBag.TopReviews != null)
    {
        var reviews = (List<Review>)ViewBag.TopReviews;

        if (reviews.Any())
        {
            <section class="reviews-section">
                <div class="reviews-header">
                    <h2>Co mówią o nas pacjenci?</h2>
                    <p class="text-muted">Prawdziwe opinie z naszych klinik</p>
                </div>

                <div class="reviews-grid">
                    @foreach (var review in reviews)
                    {
                        <div class="review-card">
                            <div class="rating-stars">
                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <i class="fa-solid fa-star"></i>
                                }
                                @for (int i = review.Rating; i < 5; i++)
                                {
                                    <i class="fa-regular fa-star" style="color: #cbd5e1;"></i>
                                }
                            </div>

                            <p class="review-comment">
                                "@review.Comment"
                            </p>

                            <hr class="review-divider" />

                            <div class="review-meta">
                                <span class="review-doctor">
                                    <i class="fa-solid fa-user-doctor"></i> dr @review.AppointmentSlot.Doctor.LastName
                                </span>
                                <span class="review-date">
                                    <i class="fa-regular fa-calendar"></i> @review.CreatedAt.ToString("dd.MM.yyyy")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    }
}
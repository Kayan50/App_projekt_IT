@model IEnumerable<App_projekt_IT.Models.AppointmentSlot>

@{
    ViewData["Title"] = "Wyszukiwarka";

    var paymentQuery = Context.Request.Query["payment"].ToString();
    var isPrywatnie = paymentQuery == "Prywatnie";
    var isNFZ = paymentQuery == "NFZ" || string.IsNullOrEmpty(paymentQuery);
}

<section id="search" class="search-section">
    <h1>Znajdź terminy i umów wizytę!</h1>
    <p>
        Szybka rezerwacja do najlepszych specjalistów.
    </p>

    <form id="search-form" class="search-form" asp-controller="Home" asp-action="Search" method="get">

        <select name="serviceId" id="service-type" asp-items="ViewBag.ServiceId" required>
            <option value="">Wybierz usługę</option>
        </select>

        <select name="cityId" id="city" asp-items="ViewBag.CityId" required>
            <option value="">Miasto</option>
        </select>

        <input type="date" name="appointmentDate" id="appointment-date"
               value="@Context.Request.Query["appointmentDate"]" required>

        <div class="radio-group">
            <input type="radio" id="payment-nfz" name="payment" value="NFZ" @(isNFZ ? "checked" : null)>
            <label for="payment-nfz">NFZ</label>

            <input type="radio" id="payment-prywatnie" name="payment" value="Prywatnie" @(isPrywatnie ? "checked" :
                                   null)>
            <label for="payment-prywatnie">Prywatnie</label>
        </div>

        <button type="submit" class="btn-primary"><i class="fa-solid fa-magnifying-glass"></i> Szukaj</button>
    </form>
</section>

<section id="results" class="results-section">
    <div id="results-container" class="grid-container">

        @if (!Model.Any() && Context.Request.Query.ContainsKey("appointmentDate"))
        {
            <div class="empty-results-text">
                Niestety, brak wolnych terminów w wybranym dniu.
            </div>

            var altSlots = ViewBag.AlternativeSlots as List<App_projekt_IT.Models.AppointmentSlot>;
            if (altSlots != null && altSlots.Any())
            {
                <div class="admin-header">
                    <h2>Najbliższy wolny termin: </h2>
                </div>

                var groupedByClinic = altSlots.GroupBy(s => s.Doctor.Clinic);
                foreach (var clinicGroup in groupedByClinic)
                {
                    var clinic = clinicGroup.Key;
                    <div class="clinic-card">
                        <h3 class="clinic-name">@clinic.Name</h3>
                        <p class="text-muted">
                            <i class="fa-solid fa-location-dot clinic-location-icon"></i>
                            @clinic.Address, @clinic.City.Name
                        </p>

                        <div class="doctors-container">
                            @foreach (var doctorGroup in clinicGroup.GroupBy(s => s.Doctor))
                            {
                                <div class="doctor-block">
                                    <div class="doctor-info doctor-details-flex">

                                        @if (doctorGroup.Key.ImageData != null && doctorGroup.Key.ImageContentType != null)
                                        {
                                            string imgBase64 = Convert.ToBase64String(doctorGroup.Key.ImageData);
                                            string imgSrc = $"data:{doctorGroup.Key.ImageContentType};base64,{imgBase64}";
                                            <img src="@imgSrc" alt="@doctorGroup.Key.LastName" class="doctor-avatar" />
                                        }
                                        else
                                        {
                                            <img src="~/images/ikonka-lekarz.png" alt="Domyślne zdjęcie" class="doctor-avatar" />
                                        }

                                        <div>
                                            <strong>@doctorGroup.Key.Title @doctorGroup.Key.FirstName @doctorGroup.Key.LastName</strong>

                                            <div class="proposed-date-wrapper">
                                                <span>Proponowana data: <strong
                                                    class="date-highlight">@doctorGroup.First().StartTime.ToString("dd.MM.yyyy")</strong></span>
                                                </div>

                                                <div class="rating-badge rating-badge-wrapper">
                                                    @if (ViewBag.DoctorRatings != null &&
                                    ViewBag.DoctorRatings.ContainsKey(doctorGroup.Key.Id))
                                                    {
                                                        var ratingInfo = ViewBag.DoctorRatings[doctorGroup.Key.Id];
                                                        <span class="rating-stars">⭐ @ratingInfo.AverageRating.ToString("0.0")</span>
                                                        <span class="rating-count text-muted">(@ratingInfo.ReviewCount opinii)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="rating-count text-muted">Brak ocen</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="time-slots">
                                            @foreach (var slot in doctorGroup)
                                            {
                                                <button type="button" class="slot-btn"
                                                        onclick="openBookingModal(@slot.Id, '@clinic.Name', '@slot.StartTime.ToString("dd.MM.yyyy")', '@slot.StartTime.ToString("HH:mm")', '@slot.Service.Name')">
                                                    @slot.StartTime.ToString("HH:mm")
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            }
            else if (Model.Any())
            {
                var groupedByClinic = Model.GroupBy(s => s.Doctor.Clinic);

                foreach (var clinicGroup in groupedByClinic)
                {
                    var clinic = clinicGroup.Key;
                    <div class="clinic-card">
                        <h3 class="clinic-name">@clinic.Name</h3>
                        <p class="text-muted">
                            <i class="fa-solid fa-location-dot clinic-location-icon"></i>
                            @clinic.Address, @clinic.City.Name
                        </p>
                        <div class="doctors-container">
                            @foreach (var doctorGroup in clinicGroup.GroupBy(s => s.Doctor))
                            {
                                <div class="doctor-block">
                                    <div class="doctor-info doctor-details-flex">

                                        @if (doctorGroup.Key.ImageData != null && doctorGroup.Key.ImageContentType != null)
                                        {
                                            string imgBase64 = Convert.ToBase64String(doctorGroup.Key.ImageData);
                                            string imgSrc = $"data:{doctorGroup.Key.ImageContentType};base64,{imgBase64}";
                                            <img src="@imgSrc" alt="@doctorGroup.Key.LastName" class="doctor-avatar" />
                                        }
                                        else
                                        {
                                            <img src="~/images/ikonka-lekarz.png" alt="Domyślne zdjęcie" class="doctor-avatar" />
                                        }

                                        <div>
                                            <strong>@doctorGroup.Key.Title @doctorGroup.Key.FirstName @doctorGroup.Key.LastName</strong>
                                            <div class="rating-badge rating-badge-wrapper">
                                                @if (ViewBag.DoctorRatings != null &&
                                    ViewBag.DoctorRatings.ContainsKey(doctorGroup.Key.Id))
                                                {
                                                    var ratingInfo = ViewBag.DoctorRatings[doctorGroup.Key.Id];
                                                    <span class="rating-stars">⭐ @ratingInfo.AverageRating.ToString("0.0")</span>
                                                    <span class="rating-count text-muted">(@ratingInfo.ReviewCount opinii)</span>
                                                }
                                                else
                                                {
                                                    <span class="rating-count text-muted">Brak ocen</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="time-slots">
                                        @foreach (var slot in doctorGroup)
                                        {
                                            <button type="button" class="slot-btn"
                                                    onclick="openBookingModal(@slot.Id, '@clinic.Name', '@slot.StartTime.ToString("dd.MM.yyyy")', '@slot.StartTime.ToString("HH:mm")', '@slot.Service.Name')">
                                                @slot.StartTime.ToString("HH:mm")
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </section>

    <div id="bookingModal" class="modal-overlay hidden">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Podsumowanie rezerwacji</h3>
            </div>

            <div class="modal-body">
                <p><strong class="modal-label">Klinika:</strong> <span id="modalClinicName"></span></p>
                <p><strong class="modal-label">Usługa:</strong> <span id="modalServiceName"></span></p>
                <p><strong class="modal-label">Data:</strong> <span id="modalDate"></span></p>
                <p><strong class="modal-label">Godzina:</strong> <span id="modalTime"></span></p>
            </div>

            <div class="action-buttons modal-actions-nomargin">
                <button type="button" onclick="confirmBooking()" class="btn-primary btn-success">
                    <i class="fa-solid fa-check"></i> Umów
                </button>
                <button type="button" onclick="closeBookingModal()" class="btn-secondary">
                    <i class="fa-solid fa-times"></i> Anuluj
                </button>
            </div>
        </div>
    </div>

    <div id="messageModal" class="modal-overlay hidden">
        <div class="modal-content modal-content-centered">
            <div class="modal-header">
                <h3 id="messageModalTitle">Informacja</h3>
            </div>
            <div class="modal-body">
                <p id="messageModalText" class="modal-message-text"></p>
            </div>
            <div class="action-buttons action-buttons-centered">
                <button type="button" id="messageModalBtn" class="btn-primary">Rozumiem</button>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                $('#city, #service-type').select2({
                    width: '100%',
                    placeholder: "Wybierz opcję"
                });

                $('#service-type').on('change', function () {
                    var selectedServiceId = $(this).val();
                    var citySelect = $('#city');

                    citySelect.empty();
                    citySelect.append('<option value="">Miasto</option>');

                    fetch('/Home/GetCitiesForService?serviceId=' + selectedServiceId)
                        .then(response => response.json())
                        .then(data => {
                            data.forEach(function (city) {
                                var newOption = new Option(city.text, city.value, false, false);
                                citySelect.append(newOption);
                            });
                            citySelect.trigger('change');
                        })
                        .catch(error => {
                            console.error('Wystąpił błąd podczas pobierania miast:', error);
                        });
                });
            });

            let currentSlotId = null;

            function showMessageModal(title, message, isSuccess, actionCallback) {
                document.getElementById('messageModalTitle').innerText = title;
                document.getElementById('messageModalText').innerText = message;

                let btn = document.getElementById('messageModalBtn');

                if (isSuccess) {
                    btn.className = "btn-primary btn-success";
                } else {
                    btn.className = "btn-secondary";
                }

                btn.onclick = function () {
                    document.getElementById('messageModal').classList.add('hidden');
                    if (actionCallback) {
                        actionCallback();
                    }
                };

                document.getElementById('messageModal').classList.remove('hidden');
            }

            function openBookingModal(slotId, clinicName, date, time, serviceName) {

                @if (!User.Identity.IsAuthenticated)
                    {
                        <text>
                                showMessageModal("Wymagane logowanie", "Musisz być zalogowany, aby umówić wizytę.", false, function() {
                                    window.location.href = '/Identity/Account/Login';
                                });
                                return;
                        </text>
                }

                    currentSlotId = slotId;
                document.getElementById('modalClinicName').innerText = clinicName;
                document.getElementById('modalServiceName').innerText = serviceName;
                document.getElementById('modalDate').innerText = date;
                document.getElementById('modalTime').innerText = time;
                document.getElementById('bookingModal').classList.remove('hidden');
            }

            function closeBookingModal() {
                document.getElementById('bookingModal').classList.add('hidden');
                currentSlotId = null;
            }

            function confirmBooking() {
                if (!currentSlotId) return;

                fetch(`/api/BookingApi/${currentSlotId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                    .then(response => {
                        return response.json().then(data => ({ status: response.status, body: data }));
                    })
                    .then(result => {
                        closeBookingModal();

                        if (result.status === 200) {
                            showMessageModal("Sukces!", result.body.message, true, function () {
                                window.location.href = '/PatientPanel';
                            });
                        } else {
                            showMessageModal("Uwaga", result.body.message, false, function () {
                                window.location.reload();
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Błąd:', error);
                        closeBookingModal();
                        showMessageModal("Błąd techniczny", "Wystąpił problem z połączeniem z serwerem.", false, null);
                    });
            }
        </script>
    }
@model App_projekt_IT.Models.Review

@{
    ViewData["Title"] = "Oceń wizytę";
}

<div class="crud-form-container" style="max-width: 600px; margin-top: 2rem;">
    <h2
        style="color: var(--brand-bg); margin-bottom: 1.5rem; text-align: center; font-weight: 700; letter-spacing: -0.5px;">
        Wystaw opinię
    </h2>

    @if (ViewBag.DoctorName != null)
    {
        <div class="alert"
             style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.2rem; margin-bottom: 2rem; text-align: center;">
            <p style="margin: 0; color: #475569; font-size: 1.05rem;">
                Oceniasz wizytę: <strong style="color: var(--brand-bg);">@ViewBag.ServiceName</strong> <br />
                u specjalisty: <strong style="color: var(--brand-bg);">@ViewBag.DoctorName</strong>
            </p>
        </div>
    }

    <form asp-action="Create" method="post" class="auth-form">
        <input type="hidden" asp-for="AppointmentSlotId" />

        <div class="form-group">
            <label asp-for="Rating">Twoja ocena:</label>
            <select asp-for="Rating">
                <option value="5">⭐⭐⭐⭐⭐ (5) - Wybitnie</option>
                <option value="4" selected>⭐⭐⭐⭐ (4) - Bardzo dobrze</option>
                <option value="3">⭐⭐⭐ (3) - Przeciętnie</option>
                <option value="2">⭐⭐ (2) - Słabo</option>
                <option value="1">⭐ (1) - Tragedia</option>
            </select>
            <span asp-validation-for="Rating" style="color: #e11d48; font-size: 0.85rem; margin-top: 0.2rem;"></span>
        </div>

        <div class="form-group">
            <label asp-for="Comment">Komentarz (opcjonalny):</label>
            <textarea asp-for="Comment" rows="4"
                      style="width: 100%; padding: 0.9rem 1rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; font-family: inherit; color: var(--text-dark); resize: vertical; outline: none; background-color: #f8fafc;"
                      placeholder="Podziel się swoimi wrażeniami. Co poszło dobrze, a co można poprawić?"></textarea>
            <span asp-validation-for="Comment" style="color: #e11d48; font-size: 0.85rem; margin-top: 0.2rem;"></span>
        </div>

        <div class="action-buttons">
            <button type="submit" class="btn-primary">
                <i class="fa-solid fa-star" style="margin-right: 0.5rem;"></i> Zapisz opinię
            </button>
            <a asp-controller="Notification" asp-action="Index" class="btn-secondary">
                <i class="fa-solid fa-xmark" style="margin-right: 0.5rem;"></i> Anuluj
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const textarea = document.querySelector("textarea");
            textarea.addEventListener("focus", function () {
                this.style.backgroundColor = "white";
                this.style.borderColor = "var(--brand-btn)";
                this.style.boxShadow = "0 0 0 3px rgba(244, 63, 94, 0.15)";
            });
            textarea.addEventListener("blur", function () {
                this.style.backgroundColor = "#f8fafc";
                this.style.borderColor = "#cbd5e1";
                this.style.boxShadow = "none";
            });
        });
    </script>
}
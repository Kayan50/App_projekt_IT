@page
@model IndexModel
@{
    ViewData["Title"] = "Profil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<partial name="_StatusMessage" for="StatusMessage" />

<h2>@ViewData["Title"]</h2>

<form id="profile-form" method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly" style="color: #e11d48; font-weight: 500;" role="alert"></div>

    <div class="form-group">
        <label asp-for="Username">Nazwa użytkownika</label>
        <input asp-for="Username" disabled style="background-color: #f1f5f9; cursor: not-allowed;" />
    </div>

    <div class="form-group">
        <label asp-for="Input.PhoneNumber">Numer telefonu</label>
        <input asp-for="Input.PhoneNumber" placeholder="Wprowadź numer telefonu" />
        <span asp-validation-for="Input.PhoneNumber"
              style="color: #e11d48; font-size: 0.85rem; margin-top: 0.2rem;"></span>
    </div>

    <button id="update-profile-button" type="submit" class="btn-primary" style="margin-top: 1rem;">Zapisz
        zmiany</button>
    </form>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
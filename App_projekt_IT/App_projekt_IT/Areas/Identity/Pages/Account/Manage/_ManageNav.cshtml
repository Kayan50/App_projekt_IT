@using App_projekt_IT.Models;
@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<a id="profile" asp-page="./Index" class="@ManageNavPages.IndexNavClass(ViewContext)">Profil</a>
<a id="email" asp-page="./Email" class="@ManageNavPages.EmailNavClass(ViewContext)">Email</a>
<a id="change-password" asp-page="./ChangePassword"
   class="@ManageNavPages.ChangePasswordNavClass(ViewContext)">Hasło</a>
@if (hasExternalLogins)
{
    <a id="external-login" asp-page="./ExternalLogins" class="@ManageNavPages.ExternalLoginsNavClass(ViewContext)">Logowania
        zewnętrzne</a>
    }
    <a id="two-factor" asp-page="./TwoFactorAuthentication"
       class="@ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)">Uwierzytelnianie dwuetapowe</a>
    <a id="personal-data" asp-page="./PersonalData" class="@ManageNavPages.PersonalDataNavClass(ViewContext)">Dane    osobowe</a>
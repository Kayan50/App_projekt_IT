@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Zmień hasło";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2>@ViewData["Title"]</h2>

<form id="change-password-form" method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly" style="color: #e11d48; font-weight: 500;" role="alert"></div>

    <div class="form-group">
        <label asp-for="Input.OldPassword">Obecne hasło</label>
        <input asp-for="Input.OldPassword" autocomplete="current-password" aria-required="true" type="password" />
        <span asp-validation-for="Input.OldPassword"
              style="color: #e11d48; font-size: 0.85rem; margin-top: 0.2rem;"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.NewPassword">Nowe hasło</label>
        <input asp-for="Input.NewPassword" autocomplete="new-password" aria-required="true" type="password" />
        <span asp-validation-for="Input.NewPassword"
              style="color: #e11d48; font-size: 0.85rem; margin-top: 0.2rem;"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.ConfirmPassword">Potwierdź nowe hasło</label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" type="password" />
        <span asp-validation-for="Input.ConfirmPassword"
              style="color: #e11d48; font-size: 0.85rem; margin-top: 0.2rem;"></span>
    </div>

    <button type="submit" class="btn-primary" style="margin-top: 1rem;">Zaktualizuj hasło</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
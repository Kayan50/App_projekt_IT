@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Skonfiguruj aplikację uwierzytelniającą";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2>@ViewData["Title"]</h2>

<div style="margin-top: 1.5rem; color: #475569; line-height: 1.6;">
    <p style="margin-bottom: 1.5rem;">Aby korzystać z aplikacji uwierzytelniającej, wykonaj poniższe kroki:</p>

    <ol style="padding-left: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem;">
        <li>
            <p>
                Pobierz aplikację do uwierzytelniania dwuetapowego (2FA), taką jak Microsoft Authenticator dla
                <a href="https://go.microsoft.com/fwlink/?Linkid=825072"
                   style="color: var(--brand-btn); text-decoration: none; font-weight: 600;">Androida</a> i
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073"
                   style="color: var(--brand-btn); text-decoration: none; font-weight: 600;">iOS</a> lub
                Google Authenticator dla
                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en"
                   style="color: var(--brand-btn); text-decoration: none; font-weight: 600;">Androida</a> i
                <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8"
                   style="color: var(--brand-btn); text-decoration: none; font-weight: 600;">iOS</a>.
            </p>
        </li>
        <li>
            <p>
                Zeskanuj kod QR (jeśli masz włączone generowanie) lub wprowadź ten klucz w swojej aplikacji: <br />
                <kbd
                style="display: inline-block; margin-top: 0.5rem; background: #f1f5f9; padding: 0.4rem 0.8rem; border-radius: 6px; border: 1px solid #cbd5e1; color: var(--brand-bg); font-family: monospace; font-weight: bold; letter-spacing: 1px; font-size: 1.1rem;">@Model.SharedKey</kbd>
            </p>
            <p style="font-size: 0.9rem; margin-top: 0.5rem;">Spacje i wielkość liter nie mają znaczenia.</p>

            <div id="qrCode" style="margin-top: 1rem;"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li>
            <p>
                Po zeskanowaniu kodu QR lub wprowadzeniu klucza, Twoja aplikacja wygeneruje unikalny kod. Wprowadź go w
                poniższym polu weryfikacji.
            </p>

            <form id="send-code" method="post" class="auth-form" style="max-width: 400px; margin-top: 1.5rem;">
                <div class="form-group">
                    <label asp-for="Input.Code">Kod weryfikacyjny</label>
                    <input asp-for="Input.Code" autocomplete="off" placeholder="np. 123456" />
                    <span asp-validation-for="Input.Code"
                          style="color: #e11d48; font-size: 0.85rem; margin-top: 0.2rem;"></span>
                </div>

                <button type="submit" class="btn-primary" style="margin-top: 1rem;">Zweryfikuj</button>
                <div asp-validation-summary="ModelOnly" style="color: #e11d48; font-weight: 500; margin-top: 1rem;"
                     role="alert"></div>
            </form>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
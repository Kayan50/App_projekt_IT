@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Usuń konto";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h2>@ViewData["Title"]</h2>

<div class="alert alert-danger"
     style="margin-bottom: 2rem; background-color: #fef2f2; padding: 1rem; border-radius: 8px 8px 8px 0;">
    <p style="margin: 0; color: #9f1239;">
        <strong>Usunięcie tych danych trwale usunie Twoje konto. Tej operacji nie można cofnąć!</strong>
    </p>
</div>

<form id="delete-user" method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly" style="color: #e11d48; font-weight: 500; margin-bottom: 1rem;" role="alert">
    </div>

    @if (Model.RequirePassword)
    {
        <div class="form-group">
            <label asp-for="Input.Password" class="form-label">Podaj hasło, aby potwierdzić</label>
            <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password"
                   aria-required="true" placeholder="Wprowadź swoje hasło" />
            <span asp-validation-for="Input.Password"
                  style="color: #e11d48; font-size: 0.85rem; margin-top: 0.2rem;"></span>
        </div>
    }

    <button type="submit" class="btn-primary" style="background-color: #e11d48; margin-top: 1rem; width: 100%;">
        <i class="fa-solid fa-trash-can" style="margin-right: 0.5rem;"></i> Usuń dane i zamknij moje konto
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
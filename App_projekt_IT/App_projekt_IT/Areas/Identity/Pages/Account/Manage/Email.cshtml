@page
@model EmailModel
@{
    ViewData["Title"] = "Zarządzaj adresem Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2>@ViewData["Title"]</h2>

<form id="email-form" method="post" class="auth-form">
    <div class="form-group">
        <label asp-for="Email">Obecny Email</label>
        <input asp-for="Email" disabled style="background-color: #f1f5f9; cursor: not-allowed;" />
    </div>

    <div class="form-group">
        <label asp-for="Input.NewEmail">Nowy Email</label>
        <input asp-for="Input.NewEmail" autocomplete="email" aria-required="true" placeholder="Wprowadź nowy email" />
        <span asp-validation-for="Input.NewEmail"
              style="color: #e11d48; font-size: 0.85rem; margin-top: 0.2rem;"></span>
    </div>

    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn-primary"
            style="margin-top: 1rem;">Zmień email</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
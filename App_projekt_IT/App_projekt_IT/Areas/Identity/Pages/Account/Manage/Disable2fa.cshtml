@page
@model Disable2faModel
@{
    ViewData["Title"] = "Wyłącz uwierzytelnianie dwuetapowe (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="crud-form-container details-container" style="border: 0; box-shadow: none;">
    <div class="admin-header">
        <h2>@ViewData["Title"]</h2>
    </div>

    <div>
        <div class="detail-block">
            <h3><i class="fa-solid fa-triangle-exclamation"></i> Ważna informacja</h3>
            <p><strong>Ta akcja jedynie wyłącza uwierzytelnianie dwuetapowe (2FA).</strong></p>
            <p>
                Wyłączenie 2FA nie powoduje zmiany kluczy skonfigurowanych w aplikacjach (np. Google Authenticator).
                Jeśli chcesz zmienić klucz używany w aplikacji, powinieneś skorzystać z opcji
                <a asp-page="./ResetAuthenticator">resetowania kluczy uwierzytelniających</a>.
            </p>
        </div>

        <form method="post" class="auth-form">
            <button class="btn-primary btn-block" type="submit">
                <i class="fa-solid fa-power-off"></i> Wyłącz 2FA
            </button>
        </form>
    </div>
</div>
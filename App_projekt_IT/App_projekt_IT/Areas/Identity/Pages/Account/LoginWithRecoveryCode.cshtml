@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Weryfikacja kodu odzyskiwania";
}

<div class="auth-section">
    <div class="auth-card">
        <h2>@ViewData["Title"]</h2>

        <p class="text-muted">
            Próbujesz zalogować się za pomocą kodu odzyskiwania. To logowanie nie zostanie zapamiętane na tym
            urządzeniu, dopóki nie zalogujesz się ponownie używając aplikacji uwierzytelniającej.
        </p>

        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Input.RecoveryCode">Kod odzyskiwania</label>
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off"
                       placeholder="Np. 1a2b-3c4d" />
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-primary btn-block">
                Zaloguj się
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
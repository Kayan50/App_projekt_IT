@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Zmiana adresu e-mail";
    bool isSuccess = ViewData["IsSuccess"] as bool? ?? false;
}

<section class="auth-section">
    <div class="auth-card" style="text-align: center; max-width: 500px;">

        @if (isSuccess)
        {
            <i class="fa-solid fa-envelope-circle-check"
               style="font-size: 4rem; color: #10b981; margin-bottom: 1.5rem;"></i>
            <h2 style="margin-bottom: 1rem;">Adres e-mail zmieniony!</h2>
            <p style="margin-bottom: 2rem; color: #64748b; line-height: 1.6;">
                Twój adres e-mail został pomyślnie zaktualizowany w systemie. Będzie teraz używany do logowania oraz
                otrzymywania powiadomień z kliniki.
            </p>
            <a asp-page="/Index" class="btn-primary"
               style="display: inline-block; text-decoration: none; width: auto; padding: 10px 30px;">
                Wróć na stronę główną
            </a>
        }
        else
        {
            <i class="fa-solid fa-circle-xmark" style="font-size: 4rem; color: #e11d48; margin-bottom: 1.5rem;"></i>
            <h2 style="margin-bottom: 1rem;">Wystapił błąd</h2>
            <p style="margin-bottom: 2rem; color: #64748b; line-height: 1.6;">
                Niestety, link autoryzacyjny jest nieprawidłowy lub zdążył wygasnąć. Względy bezpieczeństwa uniemożliwiły
                zmianę adresu.
            </p>
            <a asp-page="/Account/Manage/Email" asp-area="Identity" class="btn-secondary"
               style="display: inline-block; text-decoration: none; width: auto; padding: 10px 30px;">
                Wróć do ustawień konta
            </a>
        }

    </div>
</section>
@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Uwierzytelnianie dwuetapowe";
}

<div class="auth-section">
    <div class="auth-card">
        <h2><i class="fa-solid fa-shield-halved" style="color: var(--brand-btn); margin-right: 0.5rem;"></i>
            @ViewData["Title"]</h2>

            <p class="text-muted">
                Twoje logowanie jest zabezpieczone. Wprowadź poniżej 6-cyfrowy kod ze swojej aplikacji uwierzytelniającej.
            </p>

            <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="auth-form">
                <input asp-for="RememberMe" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Input.TwoFactorCode">Kod weryfikacyjny</label>
                    <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="off" placeholder="Np. 123456" />
                    <span asp-validation-for="Input.TwoFactorCode" class="text-danger"></span>
                </div>

                <div class="checkbox-group">
                    <input asp-for="Input.RememberMachine" type="checkbox" />
                    <label asp-for="Input.RememberMachine">Zapamiętaj to urządzenie</label>
                </div>

                <button type="submit" class="btn-primary btn-block">
                    Zaloguj się
                </button>
            </form>

            <div class="auth-links-bottom">
                <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">
                    Nie masz telefonu? Użyj kodu odzyskiwania
                </a>
            </div>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Zapomniałeś hasła?";
}

<div class="auth-section">
    <div class="auth-card">
        <h2>@ViewData["Title"]</h2>
        <p style="text-align: center; color: #475569; margin-bottom: 2rem;">
            Wprowadź swój adres email, a my wyślemy Ci link do zresetowania hasła.
        </p>

        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" style="color: #e11d48; font-weight: 500;" role="alert"></div>
            
            <div class="form-group">
                <label asp-for="Input.Email">Adres Email</label>
                <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="np. jan.kowalski@email.com" />
                <span asp-validation-for="Input.Email" style="color: #e11d48; font-size: 0.85rem; margin-top: 0.2rem;"></span>
            </div>
            
            <button type="submit" class="btn-primary btn-block">Zresetuj hasło</button>
        </form>

        <div class="auth-links-bottom">
            <a asp-page="./Login">&larr; Wróć do logowania</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}